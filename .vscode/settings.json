{
    "cmakeExplorer.parallelJobs": 0,
    "cmakeExplorer.suiteDelimiter": ".",
    "cmakeExplorer.extraCtestEnvVars": {
        "VK_INSTANCE_LAYERS": "VK_LAYER_KHRONOS_validation;VK_LAYER_KHRONOS_profiles",
        "VK_KHRONOS_PROFILES_SIMULATE_CAPABILITIES": "SIMULATE_API_VERSION_BIT,SIMULATE_FEATURES_BIT,SIMULATE_PROPERTIES_BIT,SIMULATE_EXTENSIONS_BIT,SIMULATE_FORMATS_BIT,SIMULATE_QUEUE_FAMILY_PROPERTIES_BIT,SIMULATE_VIDEO_CAPABILITIES_BIT,SIMULATE_VIDEO_FORMATS_BIT",
        "VK_KHRONOS_PROFILES_EMULATE_PORTABILITY": "false",
        "VK_KHRONOS_PROFILES_DEBUG_REPORTS": "DEBUG_REPORT_ERROR_BIT",
        "VK_KHRONOS_PROFILES_PROFILE_FILE": "${workspaceFolder}/tests/device_profiles/max_profile.json",
        "VK_LOADER_LAYERS_DISABLE": "~implicit~",
        "GTEST_BRIEF": "1",
        "GTEST_PRINT_TIME": "0",
        // Linux version
        //"VK_LAYER_PATH": "${workspaceFolder}/build/layers/Debug:${workspaceFolder}/external/Debug/64/Vulkan-Profiles/build/install/bin",
        //"VK_DRIVER_FILES": "${workspaceFolder}/build/tests/icd/Debug/VVL_Test_ICD.json",
        //"LD_LIBRARY_PATH": "${workspaceFolder}/build/layers/Debug;${workspaceFolder}/build/layers/Debug/bin:${workspaceFolder}/external/Debug/64/Vulkan-Profiles/build/install/bin",
        // Windows version
        "PATH": "${workspaceFolder}\\build\\layers\\Debug;${workspaceFolder}\\build\\layers\\Debug\\bin;${workspaceFolder}\\external\\Debug\\64\\Vulkan-Profiles\\build\\install\\bin;${env:PATH}",
        "VK_LAYER_PATH": "${workspaceFolder}\\build\\layers\\Debug;${workspaceFolder}\\external\\Debug\\64\\Vulkan-Profiles\\build\\install\\bin",
        "VK_DRIVER_FILES": "${workspaceFolder}\\build\\tests\\icd\\Debug\\VVL_Test_ICD.json"
    }
}